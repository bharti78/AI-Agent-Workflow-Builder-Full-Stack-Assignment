# Nhost project connection (server-side / general reference)
NHOST_SUBDOMAIN=
NHOST_REGION=
NHOST_GRAPHQL_URL=
NHOST_FUNCTIONS_URL=

# Same values, exposed to the browser for the Next.js frontend (frontend/).
# These are NOT secrets — they only identify which Nhost project to talk
# to. Real secrets never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

# LLM provider (Gemini / Groq / OpenRouter — pick one)
LLM_API_KEY=
LLM_MODEL=

# Never commit a real .env file. This file only documents required keys.
